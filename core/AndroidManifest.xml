<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="tachiyomi.animeextension" />

    <application android:icon="@mipmap/ic_launcher" android:allowBackup="false" android:label="${appName}">

        <meta-data android:name="tachiyomi.animeextension.class" android:value="${extClass}" />
        <meta-data android:name="tachiyomi.animeextension.nsfw" android:value="${nsfw}" />
        <meta-data android:name="aniyomix.name" android:value="${extensionName}" />
        <meta-data android:name="aniyomix.contentWarning" android:value="${contentWarning}" />
        <meta-data android:name="aniyomix.torrent" android:value="${torrent}" />
        <meta-data android:name="aniyomix.extensionLib" android:value="${extensionLib}" />

    </application>

</manifest>
